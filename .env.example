# ── Grafana ──────────────────────────────────────────────────────────────────
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=change_me_in_production
GF_ADMIN_EMAIL=admin@example.com

GF_DOMAIN=grafana.example.com
GF_ROOT_URL=https://grafana.example.com/

# ── PostgreSQL (Grafana backend database) ────────────────────────────────────
POSTGRES_DB=grafana
POSTGRES_USER=grafana
POSTGRES_PASSWORD=change_me_in_production

# ── Nginx log collection (Vector) ────────────────────────────────────────────
# Host directory containing nginx's access.log (mounted read-only into Vector).
NGINX_LOG_DIR=/var/log/nginx
# Vector runs as this non-root uid (and same gid); owns its data_dir volume.
VECTOR_UID=10000
# Group that owns the nginx logs on the host, so non-root Vector can read them.
# Debian/Ubuntu: 'adm' = 4 (run `getent group adm`). Other distros may differ.
NGINX_LOG_GID=4
# How long VictoriaLogs retains logs (e.g. 7d, 30d, 1y).
VL_RETENTION=30d
# How long VictoriaMetrics retains metrics (bare number = months; also 30d, 1y).
VM_RETENTION=12

# ── SMTP (optional – remove GF_SMTP_ENABLED or set to false to disable) ──────
GF_SMTP_ENABLED=false
GF_SMTP_HOST=smtp.example.com:587
GF_SMTP_USER=
GF_SMTP_PASSWORD=
GF_SMTP_FROM_ADDRESS=grafana@example.com
GF_SMTP_FROM_NAME=Grafana
